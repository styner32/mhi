# Explicit-only example .env (spec §4.3). Pass to serve with
#   mhi serve --env-file ./.env --watch
# Literal KEY=VALUE, optional quotes, comments only — no $VAR expansion,
# no multiline, no YAML-style colon syntax. Duplicate/unknown MHI_ keys are
# rejected. Passwords/private keys are NEVER set here (use a 0600 file).

MHI_LISTEN=192.168.0.10:9090
MHI_CLIENT=192.168.0.25
MHI_SSL_PROXY_ENABLED=false
MHI_SSL_PROXY_DOMAINS=
MHI_HTTP_CAPTURE_DOMAINS=
MHI_BODY=none
MHI_DETAILS=false
MHI_FORMAT=text
MHI_OUTPUT=
MHI_MAX_OUTPUT_BYTES=104857600
